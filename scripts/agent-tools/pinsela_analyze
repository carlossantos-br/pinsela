#!/usr/bin/env bash
# pinsela_analyze — wrapper that prefers the Pinsela API venv (Pillow + numpy
# preinstalled) and falls back to system python3.
set -euo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
SCRIPT="$HERE/pinsela_analyze.py"
API_VENV_PY="$HERE/../../apps/api/.venv/bin/python"

if [ -x "$API_VENV_PY" ]; then
    exec "$API_VENV_PY" "$SCRIPT" "$@"
else
    exec python3 "$SCRIPT" "$@"
fi
