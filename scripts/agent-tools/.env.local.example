# pinsela_web_search — API keys for stock photo providers.
#
# Copy this file to .env.local in the same directory, fill in the keys,
# then source it before running the CLI:
#
#   set -a
#   source scripts/agent-tools/.env.local
#   set +a
#
# Or, if you use direnv:
#
#   echo 'dotenv .env.local' >> .envrc
#   direnv allow
#
# All three keys are optional. With zero keys configured the tool still
# works against Lorem Picsum (placeholder images only).
#
# ------------------------------------------------------------------
# Pexels — 200 req/h free.  Get key:  https://www.pexels.com/api/
PEXELS_API_KEY=your_key_here

# Pixabay — 5000 req/h free.  Get key:  https://pixabay.com/api/docs/
PIXABAY_API_KEY=your_key_here

# Unsplash — 50 req/h free (demo).  Get key:  https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=your_key_here
