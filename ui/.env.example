# Proxy mode (default): the browser only talks to the Vite origin, and Vite forwards /api to the backend.
# Do not set an absolute VITE_API_BASE unless the API lives on another origin with CORS and cookies.
VITE_PROXY_API_TARGET=http://127.0.0.1:8000
# VITE_API_BASE=http://localhost:8000/api
# Never put secrets here. VITE_* variables are public in the frontend bundle.

VITE_PINSELA_ENGINE_V2=1
VITE_PINSELA_WORKER_COMPUTE=1
VITE_PINSELA_INTERACTION_V2=1
VITE_PINSELA_OFFSCREEN_RENDER=1
VITE_PINSELA_WEBGL_RENDER=1
VITE_PINSELA_EXPERIMENTAL_TOOLS=0
VITE_PINSELA_DESIGN_SYSTEM_V2=1
VITE_PINSELA_PERF_METRICS=1
VITE_PINSELA_THEME=default
