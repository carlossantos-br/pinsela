PINSELA_ENV=dev
PINSELA_LOG_LEVEL=INFO
# SQLite local (default for development). Postgres also works: postgresql+psycopg://user:pass@host/db
PINSELA_DATABASE_URL=sqlite:///./data/app.db
# Dev generates these on its own (secret persisted in the data dir; login via loopback bootstrap).
# Required when PINSELA_ENV=prod:
# PINSELA_SESSION_SECRET=replace-with-strong-random-secret
# PINSELA_ADMIN_USERNAME=admin
# PINSELA_ADMIN_PASSWORD_HASH=replace-with-bcrypt-hash
PINSELA_AUTH_ALLOW_ADMIN_TOKEN_HEADER=0
PINSELA_AUTH_COOKIE_DOMAIN=
# PINSELA_AUTH_ALLOWED_EMAILS=you@example.com,teammate@example.com
PINSELA_AUTH_REGISTRATION_ENABLED=0
PINSELA_AUTH_MIN_PASSWORD_LENGTH=12
PINSELA_AUTH_LOGIN_RATE_WINDOW_SECONDS=300
PINSELA_AUTH_LOGIN_RATE_MAX_ATTEMPTS=8
PINSELA_AUTH_LOGIN_LOCKOUT_SECONDS=900
PINSELA_AUTH_REGISTER_RATE_WINDOW_SECONDS=600
PINSELA_AUTH_REGISTER_RATE_MAX_ATTEMPTS=6
PINSELA_AUTH_REGISTER_LOCKOUT_SECONDS=1200
PINSELA_CORS_ORIGINS=http://localhost:5173
# Data root (default: apps/api/data inside the repo)
# PINSELA_SERVER_DATA_ROOT=./data
# Extra font directories (os.pathsep-separated), searched after the bundled OFL fonts
# PINSELA_FONT_DIRS=
# PINSELA_UI_DIST_DIR=../../ui/dist

PIPELINE_V2_ENABLED=1
